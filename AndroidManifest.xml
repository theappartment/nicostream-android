<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
 <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
 <uses-feature android:name="android.software.leanback" android:required="false"/>
 <application android:label="NicoFlix" android:theme="@style/NicoStreamTheme" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:banner="@drawable/banner" android:allowBackup="false" android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/network_security">
  <receiver android:name=".UpdateInstallReceiver" android:exported="false"/>
  <activity android:name=".MainActivity" android:label="NicoFlix" android:banner="@drawable/banner" android:exported="true" android:configChanges="keyboardHidden|orientation|screenSize">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
  </activity>
 </application>
</manifest>
